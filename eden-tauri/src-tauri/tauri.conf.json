{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDEN-VK99II",
  "version": "1.2.0",
  "identifier": "dev.eden.vk99ii",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EDEN-VK99Ⅱ「幻映」 — LingyueNerina",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["engine/*.py", "engine/*.ico", "engine/redist/*.exe", "engine/ffmpeg.exe"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
